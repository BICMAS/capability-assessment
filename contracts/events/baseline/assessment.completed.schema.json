{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bicmas:learn:event:assessment.completed",
  "title": "assessment.completed",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "organisationId", "personId", "sessionId", "planId", "actorPersonId", "occurredAt"],
  "properties": {
    "type": { "const": "assessment.completed" },
    "organisationId": { "type": "string", "minLength": 1 },
    "personId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "planId": { "type": "string", "minLength": 1 },
    "actorPersonId": { "type": "string", "minLength": 1 },
    "profileVersionId": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" }
  }
}

# Local development placeholders. Do not put production secrets in this file.

POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_USER=bicmas
POSTGRES_PASSWORD=bicmas

NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uploads
S3_ACCESS_KEY=bicmas
S3_SECRET_KEY=bicmas-local-dev

# Development HMAC secret for gateway JWTs. Not a production secret.
DEV_JWT_SECRET=dev-only-not-a-production-secret

# Each domain service reads PORT and DATABASE_URL.
# DATABASE_URL overrides the service-specific URL when it is set.
GATEWAY_URL=http://localhost:8080
GATEWAY_PORT=8080
AUDIT_PORT=8081
NOTIFY_PORT=8082
ORG_DIRECTORY_PORT=8083
ORG_DIRECTORY_URL=http://localhost:8083
CAPABILITY_FRAMEWORK_PORT=8084
CAPABILITY_FRAMEWORK_URL=http://localhost:8084
ASSESSMENT_GAP_PORT=8085
ASSESSMENT_GAP_URL=http://localhost:8085
DEVELOPMENT_PORT=8086
DEVELOPMENT_URL=http://localhost:8086
LEARNING_WEBHOOK_SECRET=dev-only-webhook-not-a-production-secret
LMS_BASE_URL=https://lms.bicmas.example

DATABASE_URL_AUDIT=postgresql://bicmas:bicmas@localhost:5432/audit?sslmode=disable
DATABASE_URL_NOTIFY=postgresql://bicmas:bicmas@localhost:5432/notify?sslmode=disable
DATABASE_URL_ORG_DIRECTORY=postgresql://bicmas:bicmas@localhost:5432/org_directory?sslmode=disable
DATABASE_URL_CAPABILITY_FRAMEWORK=postgresql://bicmas:bicmas@localhost:5432/capability_framework?sslmode=disable
DATABASE_URL_ASSESSMENT_GAP=postgresql://bicmas:bicmas@localhost:5432/assessment_gap?sslmode=disable
DATABASE_URL_DEVELOPMENT=postgresql://bicmas:bicmas@localhost:5432/development?sslmode=disable
